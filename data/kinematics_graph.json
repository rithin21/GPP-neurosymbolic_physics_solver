  },
  "nodes": [
    {"id": "domain_physics", "type": "domain", "name": "Physics"},
    {"id": "subject_mechanics", "type": "subject", "name": "Mechanics"},
    {"id": "chapter_kinematics_1d", "type": "chapter", "name": "Motion in a Straight Line"},
    {"id": "concept_uniform_motion", "type": "concept", "name": "Uniform motion"},
    {"id": "concept_uniform_acceleration", "type": "concept", "name": "Uniform acceleration"},
    {"id": "concept_relative_motion", "type": "concept", "name": "Relative motion"},
    {"id": "law_uniform_motion", "type": "law", "name": "Kinematics under uniform motion"},
    {"id": "law_kinematics_uniform_acceleration", "type": "law", "name": "Kinematics under uniform acceleration"},
    {"id": "law_relative_motion", "type": "law", "name": "Relative velocity and meeting-time kinematics"},
    {"id": "quantity_u", "type": "quantity", "symbol": "u", "name": "initial velocity", "unit": "m/s"},
    {"id": "quantity_v", "type": "quantity", "symbol": "v", "name": "final velocity", "unit": "m/s"},
    {"id": "quantity_a", "type": "quantity", "symbol": "a", "name": "acceleration", "unit": "m/s^2"},
    {"id": "quantity_t", "type": "quantity", "symbol": "t", "name": "time", "unit": "s"},
    {"id": "quantity_s", "type": "quantity", "symbol": "s", "name": "displacement", "unit": "m"},
    {"id": "quantity_distance", "type": "quantity", "symbol": "distance", "name": "distance", "unit": "m"},
    {"id": "quantity_speed", "type": "quantity", "symbol": "speed", "name": "speed", "unit": "m/s"},
    {"id": "quantity_time", "type": "quantity", "symbol": "time", "name": "time", "unit": "s"},
    {"id": "quantity_avg_v", "type": "quantity", "symbol": "avg_v", "name": "average velocity under uniform acceleration", "unit": "m/s"},
    {"id": "quantity_v1", "type": "quantity", "symbol": "v1", "name": "velocity of the first object", "unit": "m/s"},
    {"id": "quantity_v2", "type": "quantity", "symbol": "v2", "name": "velocity of the second object", "unit": "m/s"},
    {"id": "quantity_relative_speed", "type": "quantity", "symbol": "relative_speed", "name": "relative velocity between two objects", "unit": "m/s"},
    {"id": "quantity_direction", "type": "quantity", "symbol": "direction", "name": "relative-direction factor (+1 opposite directions, -1 same direction)", "unit": ""},
    {"id": "quantity_separation", "type": "quantity", "symbol": "separation", "name": "initial gap between two objects", "unit": "m"},
    {"id": "unit_m_per_s", "type": "unit", "symbol": "m/s", "name": "metre per second"},
    {"id": "unit_m_per_s2", "type": "unit", "symbol": "m/s^2", "name": "metre per second squared"},
    {"id": "unit_m", "type": "unit", "symbol": "m", "name": "metre"},
    {"id": "unit_s", "type": "unit", "symbol": "s", "name": "second"},
    {"id": "eq_s_vt", "type": "equation", "name": "Distance under uniform motion", "expression": "s = v*t", "symbols": ["s", "v", "t"]},
    {"id": "eq_average_speed", "type": "equation", "name": "Average speed", "expression": "speed = distance/time", "symbols": ["speed", "distance", "time"]},
    {"id": "eq_v_u_at", "type": "equation", "name": "First equation of motion", "expression": "v = u + a*t", "symbols": ["v", "u", "a", "t"]},
    {"id": "eq_s_ut_half_at2", "type": "equation", "name": "Second equation of motion", "expression": "s = u*t + a*t**2/2", "symbols": ["s", "u", "a", "t"]},
    {"id": "eq_v2_u2_2as", "type": "equation", "name": "Third equation of motion", "expression": "v**2 = u**2 + 2*a*s", "symbols": ["v", "u", "a", "s"]},
    {"id": "eq_avg_velocity", "type": "equation", "name": "Average velocity under uniform acceleration", "expression": "avg_v = (u+v)/2", "symbols": ["avg_v", "u", "v"]},
    {"id": "eq_time_of_flight", "type": "equation", "name": "Time of flight for a vertical projectile", "expression": "t = -2*u/a", "symbols": ["t", "u", "a"]},
    {"id": "eq_relative_speed", "type": "equation", "name": "Relative velocity of two objects", "expression": "relative_speed = v1 + direction*v2", "symbols": ["relative_speed", "v1", "v2", "direction"]},
    {"id": "eq_meeting_time", "type": "equation", "name": "Time to meet or catch up", "expression": "t = separation/relative_speed", "symbols": ["t", "separation", "relative_speed"]},
    {"id": "constraint_constant_speed", "type": "constraint", "name": "Acceleration is zero at constant speed", "trigger_phrases": ["constant speed", "uniform motion"], "implies": {"a": 0}},
    {"id": "constraint_from_rest", "type": "constraint", "name": "Initial velocity is zero when starting from rest", "trigger_phrases": ["starts from rest"], "implies": {"u": 0}},
    {"id": "constraint_comes_to_rest", "type": "constraint", "name": "Final velocity is zero when coming to rest", "trigger_phrases": ["comes to rest", "to stop", "comes to a stop", "brakes to a stop", "decelerates to rest", "decelerates to a stop"], "implies": {"v": 0}},
    {"id": "constraint_max_height_v_zero", "type": "constraint", "name": "Velocity is zero at maximum height", "trigger_phrases": ["maximum height"], "implies": {"v": 0}},
    {"id": "constraint_free_fall_upward_a_minus_g", "type": "constraint", "name": "Upward throw acceleration is -g", "trigger_phrases": ["thrown upward"], "implies": {"a": -9.8}},
    {"id": "constraint_same_direction_relative_motion", "type": "constraint", "name": "Direction factor is -1 for same-direction relative motion", "trigger_phrases": ["same direction", "chasing", "catching up", "catches up", "catch up", "overtaking", "overtake"], "implies": {"direction": -1}},
    {"id": "constraint_opposite_direction_relative_motion", "type": "constraint", "name": "Direction factor is +1 for opposite-direction relative motion", "trigger_phrases": ["towards each other", "opposite directions", "moving apart", "away from each other", "approaching each other"], "implies": {"direction": 1}}
  ],
